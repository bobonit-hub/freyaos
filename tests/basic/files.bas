10 OPEN "out.txt" FOR OUTPUT AS FILE #1
20 FOR I=1 TO 3
30 PRINT #1, I; ","; "LINE"; I
40 NEXT I
50 PRINT #1, "LAST"
60 CLOSE #1
70 OPEN "out.txt" FOR INPUT AS FILE #2
80 IF END #2 THEN 200
90 LINPUT #2, L$
100 PRINT "GOT: "; L$
110 GOTO 80
200 CLOSE #2
210 OPEN "out.txt" FOR INPUT AS FILE #3
220 INPUT #3, A, B$
230 PRINT A; B$
240 CLOSE #3
250 PRINT "DONE"
