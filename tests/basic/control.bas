10 FOR I=1 TO 3
20 ON I GOSUB 100,200,300
30 NEXT I
40 FOR J=10 TO 1 STEP -3: PRINT J;: NEXT J: PRINT
50 FOR K=1 TO 0: PRINT "NEVER": NEXT K
60 PRINT "AFTER EMPTY LOOP"
70 ON 2 GOTO 400,410
80 PRINT "NOT HERE"
100 PRINT "ONE": RETURN
200 PRINT "TWO": RETURN
300 PRINT "THREE": RETURN
400 PRINT "400": STOP
410 PRINT "410"
420 X=5: IF X>3 THEN PRINT "BIG" ELSE PRINT "SMALL"
430 IF X<3 THEN PRINT "SMALL2" ELSE PRINT "BIG2"
440 IF X=5 GOTO 460
450 PRINT "SKIPPED"
460 DEF FNA(P,Q)=P*Q+1
470 PRINT FNA(3,4)
480 PRINT INT(-2.5); SGN(-3); ABS(-7); 2^10; 7/2; -7/2
490 PRINT 1E10; 1E-5; 123456789012; .1+.2
500 PRINT 3=3; 3<>3; NOT 0; 1 AND 0; 1 OR 0
510 PRINT "A"+"B"; "X"<"Y"; "ABC"="ABC"
520 PRINT TAB(10);"T"; POS("HELLO","LL",1)
530 PRINT STR$(42); LEN(STR$(42)); VAL(" 12.5 "); CHR$(65); ASC("B")
540 RANDOMIZE
550 R=RND: IF R>=0 AND R<1 THEN PRINT "RND OK"
560 END
