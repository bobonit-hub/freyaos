10 PRINT "A"
20 X=1.5: PRINT X; "B$"; 1E5
30 REM keep
15 PRINT "MID"
LIST
RUN
DEL 15
LISTNH
PRINT 2+3
A=7
PRINT A*2
SAVE "prog.bas"
NEW
LIST
OLD "prog.bas"
LISTNH 20
RUNNH
5 STOP
RUNNH
CONT
LENGTH
PRINT 1/0
GOTO 10
NEW
10 DEF FNSUM(A,B)
20 FNSUM = A + B
30 FNEND
LISTNH
PRINT FNSUM(2,3)
PRINT FNNONE(1)
PRINT FNSUM(2)
40 DEF FNWRONG(X)
50 FNSUM = 1
60 FNEND
PRINT FNWRONG(1)
DEL 40-60
40 DEF FNLOOSE(X)
50 FNLOOSE = 1
PRINT FNLOOSE(1)
NEW
10 FNEND
RUN
10 DEF FNT(A)
20 FNT = A + 1
30 FNEND
40 PRINT FNT(6)
50 FNEND
RUN
BYE
