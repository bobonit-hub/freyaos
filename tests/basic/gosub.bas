10 ! nested FOR loops, GOSUB depth, string functions in loops
20 N=0
30 FOR I=1 TO 3
40 FOR J=1 TO 3
50 IF J=2 THEN 70
60 GOSUB 200
70 NEXT J
80 NEXT I
90 PRINT N; S$
100 FOR I=1 TO 5 STEP 2: PRINT I;: NEXT I: PRINT
110 I=0
120 I=I+1: IF I<4 THEN 120
130 PRINT I
140 FOR I=1 TO 3: FOR J=I TO 3: PRINT I*10+J;: NEXT J: NEXT I: PRINT
150 END
200 N=N+1
210 IF N>3 THEN RETURN
220 GOSUB 300
230 RETURN
300 S$=S$+CHR$(64+N)
310 RETURN
